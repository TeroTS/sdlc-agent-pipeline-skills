{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stories"],
  "properties": {
    "version": { "const": 1 },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "dependsOn",
          "goal",
          "scope",
          "contractRefs",
          "acceptanceCriteria",
          "requiredTests",
          "definitionOfDone"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "active", "done"] },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "pattern": "^S[0-9]{3,}$" },
            "uniqueItems": true
          },
          "goal": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["include", "exclude"],
            "properties": {
              "include": { "$ref": "#/$defs/nonEmptyStrings" },
              "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "contractRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiredTests": { "$ref": "#/$defs/nonEmptyStrings" },
          "definitionOfDone": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
